{
  "name": "@sasakiuri/saika-docs",
  "version": "0.4.0",
  "private": true,
  "description": "Japanese manuals and Next.js documentation site for the Saika suite",
  "license": "MIT",
  "author": "sasakiuri <sasakiuri@users.noreply.github.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/saika-docs"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss/tree/1.x/packages/saika-docs#readme",
  "scripts": {
    "content:generate": "tsx scripts/content.ts",
    "content:watch": "tsx scripts/content.ts --watch",
    "predev": "npm run content:generate",
    "dev": "run-p --race content:watch dev:next",
    "dev:next": "next dev --port 5175",
    "prebuild": "npm run content:generate && npm run assets:generate",
    "build": "next build",
    "build:static": "npm run content:generate && npm run assets:generate && cross-env DOCS_OUTPUT=export next build && tsx scripts/hosting-headers.ts && tsx scripts/static-enhancements.ts && node scripts/seal-static.mjs",
    "start": "next start --port 5175",
    "preview": "serve out --listen 4175",
    "analyze": "npm run content:generate && cross-env ANALYZE=true next build --webpack",
    "typecheck": "npm run content:generate && next typegen && tsc --noEmit",
    "lint": "run-p lint:eslint lint:prettier lint:styles lint:text",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --check .",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:text": "node scripts/textlint.mjs",
    "fix": "run-s fix:eslint fix:prettier",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "node scripts/quality-run.mjs coverage npm run test:coverage:raw",
    "test:e2e": "npm run build && playwright test",
    "test:a11y": "npm run build && playwright test --grep @a11y",
    "test:vrt": "npm run build && playwright test --grep @visual",
    "test:vrt:update": "npm run build && playwright test --grep @visual --update-snapshots",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "lhci": "npm run build && node scripts/lighthouse.mjs",
    "check": "npm run typecheck && npm run api:check && npm run env:check && npm run lint && npm run depcruise && npm run test:coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:install": "playwright install --with-deps chromium webkit firefox",
    "assets:generate": "tsx scripts/assets.ts",
    "api:generate": "openapi-typescript contracts/openapi.json --empty-objects-unknown --output src/shared/api/generated.ts",
    "api:check": "openapi-typescript contracts/openapi.json --empty-objects-unknown --check --output src/shared/api/generated.ts && node scripts/next-route-contract.mjs",
    "test:e2e:run": "node scripts/quality-run.mjs playwright npm run test:e2e:run:raw",
    "test:storybook": "node scripts/quality-run.mjs storybook npm run test:storybook:raw",
    "lhci:run": "node scripts/quality-run.mjs lighthouse npm run lhci:run:raw",
    "test:static": "tsx scripts/check-static.ts",
    "reports:summary": "node scripts/reports-summary.mjs",
    "docs:pdf": "tsx scripts/pdf.ts",
    "docs:html": "tsx scripts/pdf.ts --html",
    "docs:package": "tsx scripts/package-docs.ts",
    "graph": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\" && madge --extensions ts,tsx --ts-config tsconfig.json --image reports/dependencies.svg src",
    "security:snyk": "snyk test --all-projects",
    "lint:text:strict": "textlint \"**/*.{md,txt}\"",
    "env:check": "tsx scripts/check-env.ts",
    "text:baseline": "node scripts/textlint.mjs --update-baseline",
    "docs:pandoc": "tsx scripts/pandoc-book.ts",
    "content:new": "tsx scripts/create-document.ts",
    "artifact:verify": "node scripts/seal-static.mjs out --verify",
    "test:reproducible": "node scripts/reproducible-build.mjs",
    "test:artifacts": "node --test tests/scripts/*.test.mjs",
    "test:coverage:raw": "vitest run --coverage",
    "test:e2e:run:raw": "playwright test",
    "test:storybook:raw": "npm run build-storybook && node scripts/storybook-test.mjs",
    "lhci:run:raw": "node scripts/lighthouse.mjs",
    "test:mutation": "stryker run",
    "docs:verify": "node scripts/verify-pdf.mjs",
    "test:offline": "playwright test -c playwright.offline.config.ts",
    "api:routes:generate": "node scripts/next-route-contract.mjs --write",
    "test:preview": "node scripts/check-preview.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@axe-core/react": "4.13.0",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "1.63.0",
