    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@textlint-ja/textlint-rule-no-insert-dropping-sa": "^2.0.1",
    "@textlint-ja/textlint-rule-no-synonyms": "^1.3.0",
    "@types/jest-axe": "3.5.9",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "axe-playwright": "2.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "chokidar": "^4.0.3",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-storybook": "10.6.0",
    "fast-check": "4.9.0",
    "jest-axe": "11.0.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "madge": "8.0.0",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.26",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "1.104.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.4",
    "snyk": "1.1307.2",
    "storybook": "10.6.0",
    "stylelint": "^17.15.0",
    "sudachi-synonyms-dictionary": "^15.0.0",
    "tailwindcss": "^4.3.0",
    "textlint": "^15.8.0",
    "textlint-rule-ja-hiragana-fukushi": "^1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "^1.1.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-ja-no-orthographic-variants": "^2.0.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
