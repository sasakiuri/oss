{
  "extends": "@sasakiuri/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out", "dist", "storybook-static", "reports"]
}
