# Public URL and deployment mode. Set both URL path and BASE_PATH for a subdirectory.
NEXT_PUBLIC_SITE_URL=http://localhost:5175
NEXT_PUBLIC_BASE_PATH=
DOCS_OUTPUT=server
DOCS_SOURCE_REF=1.x
DOCS_SOFT_BREAKS=0
DOCS_IMAGE_HOSTS=

# Optional Sentry. Rates remain zero until explicitly configured.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0
NEXT_PUBLIC_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_CSP_REPORT_URI=

# Optional private Axiom destination; Web Vitals requires server/standalone output.
AXIOM_TOKEN=
AXIOM_DATASET=
NEXT_PUBLIC_WEB_VITALS=0
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_DEV_AXE=0

# Optional backend, proxied under /backend. Never expose credentials in this URL.
API_BASE_URL=
# Optional protection for the entire preview, including API endpoints.
DOCS_PREVIEW_AUTH=0
PREVIEW_AUTH_USER=
PREVIEW_AUTH_PASSWORD=

# Optional integrations. Each credential pair must be configured together.

NEXT_PUBLIC_APP_ENV=development

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
