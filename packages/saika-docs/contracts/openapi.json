{
  "openapi": "3.1.0",
  "info": {
    "title": "Saika Docs API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/catalog/": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "Document catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItem"
                  }
                }
              }
            }
          }
        },
        "summary": "List published documentation"
      }
    },
    "/api/health/": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "summary": "Check service health"
      }
    },
    "/api/vitals/": {
      "post": {
        "operationId": "reportWebVital",
        "summary": "Record a same-origin browser performance metric",
        "description": "When telemetry is disabled, returns 204 without reading the request. When enabled, requires a matching Origin and a valid JSON metric of at most 2048 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "value", "rating", "id"],
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": ["CLS", "FCP", "INP", "LCP", "TTFB"]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "rating": {
                    "type": "string",
                    "enum": ["good", "needs-improvement", "poor"]
                  },
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Metric accepted, or telemetry disabled"
          },
          "400": {
            "description": "Malformed, invalid, oversized, or unreadable metric",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["title"],
                  "properties": {
                    "title": {
                      "type": "string",
                      "const": "Invalid metric"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched Origin"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogItem": {
        "type": "object",
        "required": ["id", "title", "href", "description"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
