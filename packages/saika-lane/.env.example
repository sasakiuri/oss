# ============================================================
# Saika Lane - Environment Variables (all optional)
# ============================================================
# Copy this file to .env and adjust values as needed.
# The app functions fully without any variables set.

# --- Logging ---
# Log level: error | warn | info | debug (default: info)
# LOG_LEVEL=debug

# Custom log directory (default: <userData>/logs)
# LOGS_DIR=./logs

# --- Development ---
# Vite dev server URL (auto-set by Vite, override only if needed)
# VITE_DEV_SERVER_URL=http://localhost:5173

# Open DevTools on launch: 1 = open, 0 = skip (default: open in dev)
# OPEN_DEVTOOLS=1

# USB serial port event mode toggle for debugging (default: false)
# USE_READABLE_MODE=false

# --- Build ---
# Enable bundle analysis visualization during build (default: disabled)
# ANALYZE=1
