{
  "name": "@sasakiuri/saika-lane",
  "version": "0.2.6",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "description": "Electronic target hit point display system for shooting ranges",
  "license": "MIT",
  "author": "sasakiuri <sasakiuri@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/saika-lane"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss/tree/1.x/packages/saika-lane#readme",
  "keywords": [
    "electronic-target",
    "shooting",
    "scoring",
    "electron",
    "serialport"
  ],
  "main": "dist/main/main.js",
  "files": [
    "dist/**",
    "package.json",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "electron-rebuild -f -w serialport better-sqlite3",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "pack:win": "npm run build && electron-builder --win --dir",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "fix": "eslint --fix . && prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "license-report": "cd ../.. && generate-license-file --config packages/saika-lane/.generate-license-file.json",
    "size-limit": "size-limit",
    "analyze": "cross-env ANALYZE=1 tsc && cross-env ANALYZE=1 vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.16.0",
    "mqtt": "^5.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "13.0.0",
    "winston": "^3.17.0",
    "zod": "^4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@size-limit/file": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-istanbul": "^4.1.7",
    "autoprefixer": "10.4.27",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^17.3.9",
    "electron": "42.2.0",
    "electron-builder": "26.8.2",
    "electron-playwright-helpers": "^2.1.0",
    "generate-license-file": "^4.1.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-plugin-electron": "0.29.1",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "^4.1.7"
  }
}
