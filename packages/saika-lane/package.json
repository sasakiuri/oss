{
  "name": "@sasakiuri/saika-lane",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "Electronic target hit point display system for shooting ranges",
  "desktopName": "Saika Lane",
  "license": "MIT",
  "author": "sasakiuri <sasakiuri@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/saika-lane"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss/tree/1.x/packages/saika-lane#readme",
  "keywords": [
    "electronic-target",
    "shooting",
    "scoring",
    "electron",
    "serialport"
  ],
  "main": "dist/main/main.js",
  "files": [
    "dist/**",
    "package.json",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "type": "module",
  "scripts": {
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "pack:win": "npm run build && electron-builder --win --dir",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "dev": "vite",
    "build": "tsc && vite build",
    "prelint": "npm run lint:language",
    "lint": "eslint .",
    "lint:language": "node ../../scripts/check-english-only.mjs .",
    "fix": "eslint --fix . && prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "license-report": "node ../../scripts/generate-third-party-licenses.mjs --workspace=@sasakiuri/saika-lane",
    "license-report:check": "node ../../scripts/generate-third-party-licenses.mjs --check --workspace=@sasakiuri/saika-lane",
    "license-artifacts:check": "node ../../scripts/verify-packaged-licenses.mjs --workspace=@sasakiuri/saika-lane",
    "size-limit": "size-limit",
    "analyze": "cross-env ANALYZE=1 tsc && cross-env ANALYZE=1 vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sasakiuri/saika-protocol": "*",
    "@sasakiuri/saika-rules": "*",
    "@sasakiuri/saika-updater": "*",
    "better-sqlite3": "^13.0.3",
    "electron-store": "10.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.484.0",
    "mqtt": "^5.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "12.0.0",
    "winston": "^3.17.0",
    "zod": "^4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@size-limit/file": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-istanbul": "4.1.11",
    "autoprefixer": "10.6.0",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "17.4.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-playwright-helpers": "^2.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vite-plugin-electron": "0.29.1",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "4.1.11"
  }
}
