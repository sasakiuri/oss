{
  "extends": "@sasakiuri/typescript-config/vite.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["@testing-library/jest-dom", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
