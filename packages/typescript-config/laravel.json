{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Laravel Inertia.js TypeScript Config",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "jsx": "react-jsx"
  }
}
