{
  "name": "@sasakiuri/nilay-news",
  "version": "0.1.0",
  "private": true,
  "description": "Private Japanese news inbox on Cloudflare Workers with Jev triage",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/check-config.ts && wrangler deploy --dry-run --config wrangler.feeds.jsonc --outdir .local/feeds-dist && wrangler deploy --dry-run --outdir .local/dist",
    "test": "vitest run",
    "test:runtime": "vitest run --project runtime",
    "evaluate": "node --experimental-transform-types scripts/evaluate.ts",
    "benchmark:articles": "node --experimental-transform-types scripts/benchmark-articles.ts",
    "lint": "eslint . && node scripts/check-config.ts && node --check public/app.js",
    "fix": "eslint --fix .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test:e2e": "playwright test",
    "test:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "^1.63.0",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "jsonc-parser": "^3.3.1",
    "miniflare": "5.20260926.1-alpha",
    "typescript": "5.7.3",
    "vitest": "4.1.11",
    "wrangler": "^4.144.0"
  }
}
