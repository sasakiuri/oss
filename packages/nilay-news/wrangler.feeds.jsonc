{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nilay-news-feeds",
  "main": "src/feed-worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "placement": { "region": "aws:ap-northeast-1" },
  "limits": { "cpu_ms": 10000 },
}
