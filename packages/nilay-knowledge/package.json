{
  "name": "@sasakiuri/nilay-knowledge",
  "version": "0.1.0",
  "private": true,
  "prettier": "@sasakiuri/prettier-config",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/generate-feed.ts && tsx scripts/generate-sitemap.ts",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "new:article": "tsx scripts/new-article.ts",
    "new:news": "tsx scripts/new-news.ts",
    "analyze": "ANALYZE=true npm run build",
    "lint:eslint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:prettier": "prettier --check .",
    "fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "^0.1.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "rss": "^1.2.2",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.5",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/rss": "^0.0.32",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "25.0.1",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "6.4.3"
  },
  "description": "Nilay Knowledge website for shooting and hunting information",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/nilay-knowledge"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://knowledge.nilay.jp",
  "engines": {
    "node": ">=22.22.2"
  },
  "license": "(MIT AND CC-BY-SA-4.0)",
  "author": "Nilay"
}
