{
  "name": "@sasakiuri/nilay-knowledge",
  "version": "0.1.0",
  "private": true,
  "prettier": "@sasakiuri/prettier-config",
  "scripts": {
    "predev": "node scripts/prepare-content-styles.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/prepare-content-styles.mjs && tsx scripts/generate-feed.ts && tsx scripts/generate-sitemap.ts",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:text && npm run lint:markdown && npm run lint:metadata",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "new:article": "tsx scripts/new-article.ts",
    "taxonomy": "tsx scripts/article-taxonomy.ts",
    "lint:metadata": "tsx scripts/article-taxonomy.ts --check",
    "new:news": "tsx scripts/new-news.ts",
    "analyze": "ANALYZE=true npm run build",
    "benchmark:browser": "node scripts/measure-performance.mjs",
    "lhci": "npm run build && npm run lhci:run",
    "lhci:run": "node scripts/lighthouse.mjs",
    "test:lighthouse": "node --test scripts/lighthouse.test.mjs",
    "test:content-styles": "node --test scripts/prepare-content-styles.test.mjs",
    "test:size-budget": "node --test scripts/prepare-size-budget.test.mjs",
    "test:deployment-smoke": "node --test scripts/deployment-smoke.test.mjs",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "size-limit": "size-limit",
    "lint:eslint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:prettier": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "test:e2e": "playwright test",
    "test:seo": "playwright test e2e/seo.spec.ts --project=chromium",
    "test:seo:live": "playwright test --config=playwright.seo-live.config.ts",
    "test:install": "playwright install --with-deps chromium firefox",
    "lint:text": "textlint --config .textlintrc.json --ignore-path .textlintignore \"content/**/*.md\"",
    "lint:markdown": "tsx scripts/lint-markdown.ts",
    "lint:links": "tsx scripts/check-links.ts",
    "lint:links:external": "tsx scripts/check-links.ts --external",
    "lint:links:prepare": "tsx scripts/check-links.ts --prepare"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@vercel/speed-insights": "2.0.0",
    "@viz-js/viz": "3.30.0",
    "budoux": "0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "comlink": "^4.4.2",
    "gray-matter": "^4.0.3",
    "highlight-words-core": "1.2.3",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "4.3.0",
    "js-yaml": "^5.4.2",
    "katex": "^0.16.33",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "minisearch": "^7.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "2.10.1",
    "pdfjs-dist": "6.3.289",
    "photoswipe": "5.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "^0.0.4",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "rss": "^1.2.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/lighthouse-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.5",
    "@types/highlight-words-core": "^1.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/rss": "^0.0.32",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "fast-check": "4.9.0",
    "jsdom": "30.1.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^10.0.1",
    "remark-lint-no-duplicate-definitions": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "schema-dts": "^2.0.0",
    "size-limit": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-filter-rule-node-types": "^1.1.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vfile": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "description": "Nilay Knowledge website for shooting and hunting information",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/nilay-knowledge"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://knowledge.nilay.jp",
  "license": "(MIT AND CC-BY-SA-4.0)",
  "author": "Nilay"
}
