{
  "name": "@sasakiuri/saika-director",
  "version": "0.4.0",
  "private": true,
  "description": "Multi-lane shooting competition director for Saika Lane",
  "desktopName": "Saika Director",
  "license": "MIT",
  "author": "sasakiuri <sasakiuri@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/saika-director"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss/tree/1.x/packages/saika-director#readme",
  "engines": {
    "node": ">=22.22.0"
  },
  "main": "dist/main/main.js",
  "files": [
    "dist/**",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "prelint": "npm run lint:language",
    "lint": "eslint .",
    "lint:language": "node ../../scripts/check-english-only.mjs .",
    "fix": "eslint --fix . && prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "license-report": "node ../../scripts/generate-third-party-licenses.mjs --workspace=@sasakiuri/saika-director",
    "license-report:check": "node ../../scripts/generate-third-party-licenses.mjs --check --workspace=@sasakiuri/saika-director",
    "license-artifacts:check": "node ../../scripts/verify-packaged-licenses.mjs --workspace=@sasakiuri/saika-director",
    "size-limit": "size-limit",
    "build:win": "npm run build && electron-builder --win --publish never && node ../../scripts/namespace-update-metadata.mjs director release",
    "build:mac": "npm run build && electron-builder --mac --publish never && node ../../scripts/namespace-update-metadata.mjs director release",
    "build:linux": "npm run build && electron-builder --linux --publish never && node ../../scripts/namespace-update-metadata.mjs director release",
    "pack:win": "npm run build && electron-builder --win --dir --publish never",
    "pack:mac": "npm run build && electron-builder --mac --dir --publish never",
    "pack:linux": "npm run build && electron-builder --linux --dir --publish never"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@sasakiuri/saika-protocol": "*",
    "@sasakiuri/saika-rules": "*",
    "@sasakiuri/saika-updater": "*",
    "aedes": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.484.0",
    "mqtt": "^5.16.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@size-limit/file": "^12.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-istanbul": "4.1.11",
    "autoprefixer": "10.6.1",
    "dependency-cruiser": "17.4.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "size-limit": "^12.0.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vite-plugin-electron": "0.29.1",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "4.1.11"
  },
  "prettier": "@sasakiuri/prettier-config"
}
