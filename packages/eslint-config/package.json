{
  "name": "@sasakiuri/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint configuration",
  "author": "sasakiuri <sasakiuri@users.noreply.github.com>",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./vitest": "./vitest.js",
    "./testing-library": "./testing-library.js"
  },
  "files": [
    "index.js",
    "vitest.js",
    "testing-library.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss/tree/1.x/packages/eslint-config#readme",
  "scripts": {
    "lint": "prettier --check .",
    "lint:prettier": "prettier --check .",
    "fix": "prettier --write .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "typescript-eslint": "^8.57.2"
  },
  "peerDependencies": {
    "eslint": "^9"
  }
}
