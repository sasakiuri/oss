{
  "name": "@sasakiuri/saika-rules",
  "version": "0.2.0",
  "private": true,
  "description": "Versioned, application-neutral competition rule packs for Saika",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./issf-2026": "./src/issf-2026/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "dependency-cruiser": "17.4.3",
    "eslint": "^9",
    "prettier": "^3.9.7",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "prettier": "@sasakiuri/prettier-config"
}
