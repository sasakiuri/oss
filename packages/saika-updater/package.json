{
  "name": "@sasakiuri/saika-updater",
  "version": "0.2.1",
  "private": true,
  "description": "Shared application update state and Electron update service for Saika",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.2.1",
    "eslint": "^10",
    "prettier": "^3.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prettier": "@sasakiuri/prettier-config"
}
