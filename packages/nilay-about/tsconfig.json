{
  "extends": "@sasakiuri/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "tsBuildInfoFile": ".next/cache/typecheck.tsbuildinfo"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": [
    "node_modules",
    "__tests__",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
