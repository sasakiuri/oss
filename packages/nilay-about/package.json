{
  "name": "@sasakiuri/nilay-about",
  "version": "0.1.0",
  "private": true,
  "prettier": "@sasakiuri/prettier-config",
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "test:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "isomorphic-dompurify": "4.3.0",
    "next": "16.3.4",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.87.0",
    "react-icons": "^5.4.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "description": "Nilay About website for shooting, hunting, and wildlife management services",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git",
    "directory": "packages/nilay-about"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://about.nilay.jp",
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
