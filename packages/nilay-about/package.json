{
  "name": "@sasakiuri/nilay-about",
  "version": "0.1.0",
  "private": true,
  "prettier": "@sasakiuri/prettier-config",
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true npm run build",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "test:install": "playwright install --with-deps chromium firefox webkit",
    "predev": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "next": "16.3.5",
    "next-seo": "^6.6.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.88.0",
    "react-icons": "^5.4.0",
    "tailwind-merge": "^2.6.0",
    "isomorphic-dompurify": "2.36.0",
    "zod": "^3.24.1",
    "zustand": "5.0.15",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.38.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "25.0.1",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@sasakiuri/typescript-config": "*",
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "vite": "6.4.3"
  },
  "description": "Nilay About website for shooting, hunting, and wildlife management services",
  "repository": {
    "type": "git",
