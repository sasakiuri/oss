{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "ANALYZE"]
    },
    "dev": {
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "MICROCMS_SERVICE_DOMAIN",
        "MICROCMS_API_KEY",
        "SLACK_WEBHOOK_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "LOG_MASKING_SECRET",
        "VERCEL_ENV",
        "VERCEL_URL"
      ]
    }
  }
}
