# ローカル開発では、このファイルを .env.local にコピーします。
# 実際の認証情報をこのファイルに書かないでください。

# サイトの絶対 URL。本番は公開 URL をビルド前と実行時に設定します。
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ログの個人情報マスキング用。本番実行では 16 文字以上が必須です。
# openssl rand -hex 32 で生成し、以下のプレースホルダーを置き換えて有効にします。
# 本番環境では生成した強い秘密鍵を安全に保管し、各サーバーに設定してください。
# LOG_MASKING_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"

# ニュース API を使う場合のみ設定します。ビルドには不要です。
# https://SERVICE_DOMAIN.microcms.io の SERVICE_DOMAIN 部分を設定します。
# API キーはサーバー専用です。本番では news の GET のみを許可します。
# MICROCMS_SERVICE_DOMAIN="your-service"
# MICROCMS_API_KEY="REPLACE_WITH_MICROCMS_API_KEY"

# お問い合わせを送信する場合のみ、Slack Incoming Webhook の URL を設定します。
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK"

# 分散レート制限を使う場合は、Upstash の URL とトークンを両方設定します。
# 現在の本番実装は未設定・接続エラー時に制限を省略します。
# UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_REDIS_HOST.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REST_TOKEN"

# NODE_ENV は Next.js、VERCEL_ENV と VERCEL_URL は Vercel が設定します。
# バンドル分析は npm run analyze --workspace=@sasakiuri/nilay-about で有効にします。
