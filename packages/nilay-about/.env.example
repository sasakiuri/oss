# Supabase PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Get this from Supabase Dashboard > Settings > Database > Connection string
# Note: @ in password must be URL-encoded as %40
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Slack Webhook URL for contact form submissions
# Get this from Slack App > Incoming Webhooks > Add New Webhook to Workspace
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Site URL (optional, defaults to https://about.nilay.jp)
NEXT_PUBLIC_SITE_URL="https://about.nilay.jp"
