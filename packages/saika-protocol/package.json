{
  "name": "@sasakiuri/saika-protocol",
  "version": "0.2.0",
  "private": true,
  "description": "Application-neutral MQTT contracts for Saika Lane and Director",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@sasakiuri/eslint-config": "*",
    "@sasakiuri/prettier-config": "*",
    "@sasakiuri/typescript-config": "*",
    "eslint": "^10",
    "prettier": "^3.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "dependency-cruiser": "18.2.0"
  },
  "prettier": "@sasakiuri/prettier-config",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
