{
  "$schema": "https://unpkg.com/syncpack@14.2.0/schema.json",
  "source": ["package.json", "packages/*/package.json"],
  "versionGroups": [
    {
      "label": "Internal packages use workspace wildcard",
      "dependencies": ["@sasakiuri/**"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "*"
    },
    {
      "label": "Nilay websites share Vitest 4 and Tailwind 4",
      "packages": ["@sasakiuri/nilay-knowledge", "@sasakiuri/nilay-about"],
      "dependencies": [
        "@types/node",
        "@vitest/coverage-v8",
        "vitest",
        "tailwindcss",
        "typescript",
        "tailwind-merge",
        "lucide-react",
        "prettier-plugin-tailwindcss"
      ]
    },
    {
      "label": "Nilay About retains its Zod 3 form schemas",
      "packages": ["@sasakiuri/nilay-about"],
      "dependencies": ["zod", "@hookform/resolvers"]
    },
    {
      "label": "Saika Docs uses a separate web toolchain from the Electron apps",
      "packages": ["@sasakiuri/saika-docs"],
      "dependencies": [
        "@types/node",
        "@vitejs/plugin-react",
        "jsdom",
        "tailwindcss",
        "typescript",
        "vite",
        "vitest",
        "prettier-plugin-tailwindcss",
        "@playwright/test",
        "@axe-core/playwright",
        "lucide-react",
        "stylelint",
        "@vitest/coverage-v8"
      ]
    }
  ],
  "semverGroups": [
    {
      "label": "Use exact versions for TypeScript tooling",
      "packages": ["**"],
      "dependencies": ["typescript"],
      "range": ""
    }
  ]
}
