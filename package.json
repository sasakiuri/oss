{
  "name": "@sasakiuri/oss",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Saika Lane and shared configurations",
  "keywords": [
    "saika-lane",
    "electronic-target",
    "shooting",
    "monorepo"
  ],
  "license": "MIT",
  "author": "sasakiuri",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.9.2"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "fix": "turbo fix",
    "test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "license-check": "licensee --errors-only",
    "syncpack": "syncpack lint",
    "cspell": "cspell \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "turbo typecheck",
    "knip": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "cspell": "^10.0.0",
    "eslint": "^10",
    "husky": "^9.1.7",
    "knip": "^6.6.1",
    "licensee": "^12.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "syncpack": "^14.2.1",
    "turbo": "^2.8.20"
  },
  "volta": {
    "node": "22.15.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "tar": ">=7.5.11"
  }
}
