{
  "name": "@sasakiuri/oss",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Saika Lane, Saika Director, Saika Vista, Saika Docs, and shared configurations",
  "keywords": [
    "saika-lane",
    "saika-director",
    "saika-vista",
    "saika-docs",
    "electronic-target",
    "shooting",
    "monorepo"
  ],
  "license": "MIT",
  "author": "sasakiuri <sasakiuri@users.noreply.github.com>",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.4"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasakiuri/oss.git"
  },
  "bugs": {
    "url": "https://github.com/sasakiuri/oss/issues"
  },
  "homepage": "https://github.com/sasakiuri/oss#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci:packages": "node scripts/run-package-ci.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "npm run lint:text && turbo lint",
    "lint:text": "node scripts/lint-text.mjs",
    "fix": "npm run fix:text && turbo fix",
    "fix:text": "node scripts/lint-text.mjs --fix",
    "test:text": "node --test scripts/lint-text.test.mjs",
    "test:release-metadata": "node --test scripts/namespace-update-metadata.test.mjs",
    "test:pre-release": "node --test scripts/pre-release-check.test.mjs",
    "test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "license-check": "licensee --errors-only",
    "license-report": "node scripts/generate-third-party-licenses.mjs",
    "license-report:check": "node scripts/generate-third-party-licenses.mjs --check",
    "license-artifacts:check": "node scripts/verify-packaged-licenses.mjs",
    "syncpack": "syncpack lint",
    "cspell": "cspell",
    "typecheck": "turbo typecheck",
    "knip": "knip",
    "prepare": "node .husky/install.mjs",
    "postinstall": "electron-rebuild -f -w @serialport/bindings-cpp,better-sqlite3 --module-dir=."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "^4.0.3",
    "cspell": "^10.0.1",
    "eslint": "^9",
    "generate-license-file": "4.1.1",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "knip": "^6.26.0",
    "licensee": "^12.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "stylelint": "^17",
    "syncpack": "^14.2.1",
    "textlint": "^15.8.0",
    "textlint-rule-ja-space-between-half-and-full-width": "^2.4.2",
    "turbo": "^2.10.11"
  },
  "volta": {
    "node": "22.22.2",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "tar": ">=7.5.22",
    "tmp": "^0.2.5",
    "qs": "^6.15.1",
    "js-yaml@^3.0.0": "^3.15.2",
    "js-yaml@^4.0.0": "^4.3.2",
    "sharp": "^0.35.4",
    "istanbul-lib-processinfo": {
      "uuid": "^11.1.1"
    },
    "jest-junit": {
      "uuid": "^11.1.1"
    },
    "jest": "30.2.0",
    "jest-circus": "30.2.0",
    "jest-environment-node": "30.2.0",
    "jest-runner": "30.2.0",
    "@storybook/test-runner": {
      "uuid": "^11.1.1"
    },
    "prisma": {
      "mysql2": "3.24.4",
      "@prisma/config": {
        "deepmerge-ts": "8.0.2"
      }
    }
  }
}
